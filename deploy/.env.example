# Mau bien moi truong cho nhip mot tren VPS.
# Chep thanh .env ngay canh file nay roi dien gia tri that:
#     cp .env.example .env && chmod 600 .env
# .env that KHONG BAO GIO duoc commit — xem .gitignore.

# --- Bat buoc --------------------------------------------------------------
# Supabase. Do tu VPS nay (103.77.208.166), ngay 04/11/2026:
#
#   direct   db.<ref>.supabase.co:5432   chi co ban ghi AAAA. VPS khong co IPv6
#                                        global nen KHONG KET NOI DUOC. Muon
#                                        dung thi phai mua goi IPv4 add-on.
#   session  pooler:5432                 IPv4 52.74.252.201, co prepared
#                                        statement. DUNG CAI NAY.
#   trans.   pooler:6543                 IPv4, khong co prepared statement.
#                                        db.py tu tat khi thay :6543.
#
# Migration (schema.sql) cung chay qua cong 5432.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Tuy chon --------------------------------------------------------------
# Nhip hai can key nay. Khong co thi extract.py bi bo qua, nhip mot van chay.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Hai Do IT (Story 1.1) -------------------------------------------------
# Bien moi truong cho API va Compose prod/local
# HAIDO_DATABASE_URL dung driver postgresql+psycopg://
HAIDO_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# HAIDO_LOCAL_DB_PASSWORD=haido_local
# HAIDO_LOCAL_DB_PORT=5433
# IMAGE_TAG=main
# CANH BAO: Chi bat co nay khi thuc su muon chay migration len host tu xa (vd: Supabase/VPS).
# HAIDO_ALLOW_REMOTE_MIGRATION=1
