# Mau bien moi truong cho nhip mot tren VPS.
# Chep thanh .env ngay canh file nay roi dien gia tri that:
#     cp .env.example .env && chmod 600 .env
# .env that KHONG BAO GIO duoc commit — xem .gitignore.

# --- Bat buoc --------------------------------------------------------------
# Supabase. Cong 6543 la shared pooler che do transaction: sync_pg.py da dat
# prepare_threshold=None cho no. Chay migration thi dung cong 5432 (session).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Tuy chon --------------------------------------------------------------
# Co key thi step-05-extract chay, khong co thi pipeline tu bo qua buoc do.
# ANTHROPIC_API_KEY=sk-ant-...

# Dung cho step-03 va step-06. Chua co thi hai buoc do bi bo qua.
# TYPESAFE_API_KEY=
